{
  "manifest_version": 3,
  "name": "Jira UI Tweaks",
  "version": "1.2.0",
  "description": "Tweaks Jira Cloud's board UI: custom filters as toggle buttons, plus a more compact toolbar and search.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Jira UI Tweaks",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.atlassian.net/*"],
      "js": ["settings.js", "content.js", "toolbar.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
