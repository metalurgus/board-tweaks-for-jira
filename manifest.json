{
  "manifest_version": 3,
  "name": "Board Tweaks for Jira",
  "version": "1.3.0",
  "description": "Shows Jira board quick filters as one-click toggle buttons, and makes the board toolbar and search more compact.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Board Tweaks for Jira",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.atlassian.net/*"],
      "js": ["settings.js", "content.js", "toolbar.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
